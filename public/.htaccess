DirectoryIndex index.html index.htm
Options -Indexes
RewriteEngine On

# Place URLs are the main EarthMap app. Internal rewrite only.
# No hash character in these rules (a bare hash comments out the flags).
RewriteRule ^countries/[a-z0-9-]+/?$ /index.html [L]
RewriteRule ^countries/[a-z0-9-]+/[a-z0-9-]+/?$ /index.html [L]
RewriteRule ^(ja|ko|de|fr|es|pt-BR|zh-Hans|id|ru)/countries/[a-z0-9-]+/?$ /index.html [L]

# Trailing-slash for real directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ $1/ [R=301,L]
